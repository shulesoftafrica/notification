# Notification-specific throttling
NOTIFICATION_SEND_MAX_ATTEMPTS=2
NOTIFICATION_SEND_DECAY_SECONDS=1
NOTIFICATION_BULK_SEND_MAX_ATTEMPTS=1
NOTIFICATION_BULK_SEND_DECAY_SECONDS=2

# WaSender throttling
WASENDER_MAX_ATTEMPTS=5
WASENDER_DECAY_SECONDS=1

# Queue throttle behaviour
THROTTLE_RELEASE_JITTER_SECONDS=3
QUEUE_RETRY_WINDOW_MINUTES=360

# Redis connection for throttling
THROTTLE_REDIS_CONNECTION=default
THROTTLE_KEY_PREFIX=throttle