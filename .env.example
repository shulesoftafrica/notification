APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Use 'warning' in production: per-request and per-job info logs grow fast.
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Queue (see config/queue.php). retry_after must exceed the longest job timeout (120s).
REDIS_QUEUE_RETRY_AFTER=200
REDIS_QUEUE_BLOCK_FOR=5
REDIS_QUEUE_AFTER_COMMIT=true
# How long a message job may keep retrying/being throttled before it is failed.
QUEUE_RETRY_WINDOW_MINUTES=360
THROTTLE_RELEASE_JITTER_SECONDS=3
QUEUE_MONITOR_MAX_JOBS=1000
# Days to keep notification_logs/api_request_logs; 0 disables pruning.
NOTIFICATION_LOG_RETENTION_DAYS=0

# Redis: failover counters, health cache, locks and rate limits are shared by all
# workers and need atomic operations.
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Outbound email recipient filtering (see config/email_filter.php)
# EMAIL_FILTER_ENABLED=true
# EMAIL_FILTER_MODE=allowlist            # allowlist | blocklist
# EMAIL_FILTER_BLOCKED_DOMAINS=          # extra domains to skip, comma separated
# EMAIL_FILTER_ALLOWED_DOMAINS=          # extra domains that always pass
# EMAIL_FILTER_BLOCKED_TLDS=             # extra extensions to skip, e.g. de,ru
# EMAIL_FILTER_ALLOWED_TLDS=             # replaces the default allowed extension list
# EMAIL_FILTER_BLOCKED_LOCAL_PARTS=      # extra mailbox names to skip, e.g. noreply
